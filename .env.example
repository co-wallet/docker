# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# JWT
JWT_SECRET=change-me-in-production

# Public URL of the app — used to build invite links
APP_URL=https://mywallet.example.com

# App port (host port where frontend is exposed)
APP_PORT=3000

# Development-only host ports
BACKEND_PORT=8081
POSTGRES_PORT=5432

# Admin account (created on first launch if no users exist)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@co-wallet.local
# Leave empty to auto-generate a password (printed to logs on first start)
ADMIN_PASSWORD=

# SMTP for invite emails (optional — if not set, invite links are shown in the UI)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASS=
SMTP_FROM=no-reply@example.com
